--- !u!114 &6847385694834305734
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5714436492874830897}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=center><b><size=130%>GAME OBJECTIVE</size></b></align>\r\n\r\n<b>Score
    Points By:</b>\r\n1. <b>LOADING</b> the best combination of passengers, cars,
    and trucks onto the scow within the <color=#FFD700>two-minute</color> time limit.\r\n2.
    <b>DRIVING</b> the Marilyn M ferry pulling the scow across the St. Clair river
    without hitting another boat, freighter, or running aground.\r\n3. <b>DOCKING
    AND UNLOADING</b> the ferry and scow within the time limits for each difficulty
    level.\r\n   <i>(Score 1 point for each second under:</i>\r\n   <color=#00FF00>EASY:
    11 minutes</color>,\r\n   <color=#FFA500>MEDIUM: 9 minutes</color>,\r\n   <color=#FF5555>HARD:
    7 minutes</color><i>)</i>\r\n\r\n<color=#FF4444><b>20 Points Deducted For:</b></color>\r\n\u2022
    Leaving the Courtright, Canada dock faster than <b>5 mph</b>\r\n\u2022 Landing
    at the St. Clair, USA dock faster than <b>1 mph</b>\r\n\r\n<b>Challenges:</b>\r\n\u2022
    Total <color=#FFD700>2-minute</color> limit to load and unload\r\n\u2022 Each
    passenger \u2013 <color=#00FFAA><b>2 points</b></color> <i>(5 sec load time)</i>\r\n\u2022
    Each car \u2013 <color=#00FFAA><b>10 points</b></color> <i>(30 sec load time)</i>\r\n\u2022
    Each truck \u2013 <color=#00FFAA><b>25 points</b></color> <i>(60 sec load time)</i>\r\n\r\n<color=#FF0000><b>GAME
    OVER:</b></color>\r\n\u2022 Hitting or being hit by a freighter or another boat\r\n\u2022
    Running aground on the sand bar (in the middle of the river left of the red buoy
    with the flashing light)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
