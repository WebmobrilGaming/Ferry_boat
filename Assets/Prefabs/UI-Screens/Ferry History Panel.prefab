  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In this simulator you will be piloting the Marilyn M ferry boat\n from
    Courtright, Ontario, Canada to St. Clair, Michigan, USA\n in 1950.The Marilyn
    M was one of 12 different ferry boats that\n carried passengers, cars and trucks
    across the St. Clair River\n between 1850 and 1965. It was one of three ferry
    boat types that\n carried passengers in a separate boat that pulled the cars
    and\n trucks on an unpowered scow (barge) connected only by a cable.\_\nThe Marilyn
    M captain found it difficult to drive and dock two boats\n instead of one without
    damaging the cars and trucks on the scow."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 484f34be4005535449fd4547b7ade1d2, type: 2}
